ENVIRONMENT=development
PROCESSING_MODE=live
# Keep stable across restarts to resume existing processor offsets.
PROCESSING_RUN_ID=current
DERIVATIVES_SPOT_MAX_AGE_SECONDS=5
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Microsoft Fabric Eventstream export (disabled for local development)
FABRIC_ENABLED=false
FABRIC_KAFKA_BOOTSTRAP_SERVERS=
FABRIC_KAFKA_USERNAME=
FABRIC_KAFKA_PASSWORD=
FABRIC_SECURITY_PROTOCOL=SASL_SSL
FABRIC_SASL_MECHANISM=PLAIN
FABRIC_TOPIC_METRICS=
FABRIC_TOPIC_CROSS_VENUE=
FABRIC_TOPIC_DERIVATIVES=
FABRIC_TOPIC_ANOMALIES=
FABRIC_TOPIC_INTEGRITY=
BINANCE_WS_BASE_URL=wss://data-stream.binance.vision
BINANCE_TRADE_SYMBOL=BTCUSDT
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
COINBASE_TRADE_SYMBOL=BTC-USD
KRAKEN_WS_URL=wss://ws.kraken.com/v2
KRAKEN_TRADE_SYMBOL=BTC/USD
OKX_WS_URL=wss://ws.okx.com:8443/ws/v5/public
OKX_TRADE_SYMBOL=BTC-USDT
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/spot
BYBIT_TRADE_SYMBOL=BTCUSDT
CROSS_VENUE_STALE_AFTER_MS=5000
CROSS_VENUE_CALCULATION_INTERVAL_MS=1000
CROSS_VENUE_MIN_ACTIVE_VENUES=3
DERIVATIVES_OI_POLL_INTERVAL_MS=5000
DERIVATIVES_NO_TRADE_TIMEOUT_MS=15000
INTEGRITY_MAX_EVIDENCE_AGE_SECONDS=5
BINANCE_ORDERBOOK_SYMBOL=BTCUSDT
BINANCE_ORDERBOOK_INTERVAL_MS=100
BINANCE_REST_BASE_URL=https://data-api.binance.vision
BINANCE_ORDERBOOK_SNAPSHOT_LIMIT=1000
ORDERBOOK_PUBLISH_DEPTH=20
ORDERBOOK_PUBLISH_INTERVAL_MS=250
FEATURE_CALCULATION_INTERVAL_MS=1000

# Browser access is bound to 127.0.0.1 by Docker Compose.
KAFKA_UI_PORT=8080

# Development cluster identity (not a secret); do not change for existing data.
KAFKA_CLUSTER_ID=Mk1JRW5naW5lRGV2Q2x1cw
KAFKA_HEAP_OPTS="-Xms512m -Xmx512m"

# ClickHouse analytical persistence
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DATABASE=market_integrity
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_ENABLED=true
CLICKHOUSE_BATCH_SIZE=500
CLICKHOUSE_FLUSH_INTERVAL_MS=1000
CLICKHOUSE_MAX_RETRIES=3
CLICKHOUSE_RETRY_BACKOFF_MS=500

# Grafana local development (binds to 127.0.0.1:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
CLICKHOUSE_GRAFANA_USER=grafana_reader
CLICKHOUSE_GRAFANA_PASSWORD=

# Read-only MCP query service (passwords are required in .env)
CLICKHOUSE_MCP_USER=mcp_reader
CLICKHOUSE_MCP_PASSWORD=
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_QUERY_TIMEOUT_SECONDS=5
MCP_MAX_RESULT_ROWS=500

# Optional external alert delivery (disabled by default). Never commit a webhook URL.
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=
